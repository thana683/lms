{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [
    {
      "src": "api/index.php",
      "use": "vercel-php@0.7.4",
      "config": { "includeFiles": ["public/**", "resources/**", "bootstrap/**", "config/**", "routes/**", "app/**", "database/**"] }
    },
    {
      "src": "public/build/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/build/(.*)", "dest": "public/build/$1" },
    { "src": "/(.*)", "dest": "api/index.php" }
  ]
}
